# One entry per ecosystem and branch of dependabot.target-branches; every commit is
# chore(deps), so no update cuts a release. The locked tools (tools/uv.lock,
# package-lock.json) follow odoo-nix's series data and are no Dependabot entry; a project
# moves its submodules with the scheduled `odoo project update` (deps.yml).
{% set d = cfg.dependabot %}
version: 2
updates:
{% for branch in d["target-branches"] %}
  - package-ecosystem: github-actions
    directory: /
    target-branch: {{ branch | json_string }}
    schedule:
      interval: {{ d.schedule }}
    cooldown:
      default-days: {{ d["cooldown-days"] }}
    commit-message:
      prefix: chore(deps)
    labels: [dependencies]
    # The caller pins move with the engine (`odoo-init --sync`).
    ignore:
      - dependency-name: "{{ odoo_nix.owner }}/{{ odoo_nix.name }}/*"
      - dependency-name: "Avunu/python-devops-nix/*"
    groups:
      actions:
        patterns: ["*"]
  - package-ecosystem: nix
    directory: /
    target-branch: {{ branch | json_string }}
    schedule:
      interval: {{ d.schedule }}
    # An addon repository's OCB follows the branch tip: a cooldown picks an odoo/odoo commit
    # inside one of OCB's merges, which has no OCB pyproject.toml and does not evaluate.
    cooldown:
      default-days: {{ d["cooldown-days"] }}
      exclude: ["ocb"]
    commit-message:
      prefix: chore(deps)
    labels: [dependencies]
    # Moved by `odoo-nix repo rollout` or `odoo-init --sync`.
    ignore:
      - dependency-name: "odoo-nix"
      - dependency-name: "standards-profile"
{% endfor %}
  # odoo-nix:local-begin updates
  # odoo-nix:local-end updates
