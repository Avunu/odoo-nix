{# The locked odoo-nix revision. A lock without one (a path: override, as odoo-nix's own
   self-tests lock it) keeps the file's pin: this workflow's, else odoo-lint.yml's. #}
{% macro uses(workflow) %}
{% set at = odoo_nix.owner ~ "/" ~ odoo_nix.name ~ "/.github/workflows/" %}
{% if odoo_nix.rev %}
{{ at ~ workflow }}@{{ odoo_nix.rev }} # v{{ odoo_nix.version }}
{%- else %}
{% set kept = pin(at ~ workflow, "", "v" ~ odoo_nix.version) %}
{% if "@ #" in kept %}
{% set kept = pin(at ~ "odoo-lint.yml", "", "v" ~ odoo_nix.version).replace("odoo-lint.yml", workflow) %}
{% endif %}
{{ kept }}
{%- endif %}
{% endmacro %}
{# The CI App: its client ID (an Actions variable) and private key (a secret), by name. #}
{% macro app_with() %}
{% set app = cfg.ci["github-app"] %}
{% if app["app-id"] %}
      client-id: {{ "${{ vars." ~ app["app-id"] ~ " }}" }}
{% endif %}
{% endmacro %}
{# The read-only App the jobs that run the repository's code fetch private submodules with
   (ci.submodule-app), never the CI App. #}
{% macro submodule_with() %}
{% set app = cfg.ci.get("submodule-app") or {} %}
{% if app.get("app-id") %}
      submodule-client-id: {{ "${{ vars." ~ app["app-id"] ~ " }}" }}
{% endif %}
{% endmacro %}
{# The `secrets:` block: the CI App's key with `main`, the submodule App's with `submodule`. #}
{% macro secret_block(main=true, submodule=false) %}
{% set app = cfg.ci["github-app"] %}
{% set sub = cfg.ci.get("submodule-app") or {} %}
{% set with_main = main and app["private-key"] %}
{% set with_sub = submodule and sub.get("private-key") %}
{% if with_main or with_sub %}
    secrets:
{% if with_main %}
      APP_PRIVATE_KEY: {{ "${{ secrets." ~ app["private-key"] ~ " }}" }}
{% endif %}
{% if with_sub %}
      SUBMODULE_PRIVATE_KEY: {{ "${{ secrets." ~ sub["private-key"] ~ " }}" }}
{% endif %}
{% endif %}
{% endmacro %}
{% macro app_secrets() %}{{ secret_block(main=true) }}{% endmacro %}
