# The dev shell is rebuilt when the files its environments are built from change.
watch_file {{ config_file }} {{ "uv.lock" if lock_dir == "." else lock_dir ~ "/uv.lock" }} {{ "modules.txt" if shape == "project" else ".odoo-series" }} tools/pyproject.toml tools/uv.lock package.json package-lock.json
{% if shape == "project" %}
# Nix reads the submodules while it evaluates the flake (inputs.self.submodules),
# before the dev shell can check them out: on a fresh clone, check them out first,
# with odoo-nix-sources at the revision flake.lock pins (odoo-nix docs, "A fresh clone").
if git submodule status --recursive 2> /dev/null | grep '^-' > /dev/null; then
  nix run github:Avunu/odoo-nix#bootstrap -- "$PWD" || true
fi
{% endif %}
# odoo-nix:local-begin envrc
# odoo-nix:local-end envrc
use flake . --no-pure-eval
