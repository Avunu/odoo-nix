{
  "$comment": "VS Code data (DESIGN.md §3.1 ide). seed and seed_extensions: what modules/devenv.nix writes into a missing .vscode/settings.json and .vscode/extensions.json, opted in or not, and what the ide module adds to its spec for a file sync creates (context.ide_specs). managed: the ide module's jsonc-merge spec (templates/ide/*.json.j2). set and union hold no leaf or item the seed writes (Odoo.odoo is the seed's recommendation), so retracting ide never deletes what the shell seeded (tests/test_ide_real.py).",
  "seed": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.analysis.extraPaths": [".devenv/state/pythonpath"],
    "files.watcherExclude": { "**/.devenv/**": true, "**/.direnv/**": true },
    "search.exclude": { "**/.devenv/**": true, "**/.direnv/**": true }
  },
  "seed_extensions": ["Odoo.odoo"],
  "managed": {
    "set": {
      "python.languageServer": "None",
      "ty.diagnosticMode": "off",
      "ty.disableLanguageServices": true,
      "ruff.path": ["${workspaceFolder}/tools/.venv/bin/ruff"],
      "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
      },
      "[xml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
      },
      "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
      },
      "prettier.requireConfig": true,
      "prettier.prettierPath": "./node_modules/prettier",
      "files.watcherExclude": {
        "**/.odoo-nix/**": true,
        "**/tools/.venv/**": true,
        "**/node_modules/**": true
      },
      "search.exclude": {
        "**/.odoo-nix/**": true,
        "**/tools/.venv/**": true,
        "**/node_modules/**": true
      }
    },
    "union": {
      "recommendations": {
        "ensure": [
          "charliermarsh.ruff",
          "esbenp.prettier-vscode",
          "dbaeumer.vscode-eslint"
        ],
        "opposite": "unwantedRecommendations"
      }
    },
    "forbidden": [["Odoo.serverConfigPath"]],
    "never": [["Odoo.selectedProfile"], { "prefix": "python-envs." }]
  }
}
