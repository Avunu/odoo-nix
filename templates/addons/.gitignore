# odoo-nix addons mode: links the dev shell makes (OCB and the external
# sources under .odoo-nix/, the rest at the root). No trailing slash on the
# links: git records a symlink as a file.
/.odoo-nix/
/odoo.conf
/odools.toml
/.venv

# devenv state: the PostgreSQL cluster and Odoo's filestore
/.devenv/
/.direnv/
/result
/result-*
__pycache__/
*.py[cod]
